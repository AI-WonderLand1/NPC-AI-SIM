# NPC-AI-SIM durable memory sidecar
# Copy to memory_service/.env for local development only.
# Production secrets should come from the server secret manager/environment.

# Shared bearer token used by the Node NPC server to call this private service.
MEMORY_SERVICE_TOKEN="replace-with-a-long-random-token"

# MongoDB Atlas / compatible deployment. Keep this server-side only.
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/"
MONGODB_TIMEOUT_MS="5000"

# Mem0 MongoDB storage settings.
MEM0_DB_NAME="npc_ai_sim"
MEM0_COLLECTION_NAME="npc_memories"
NPC_RELATIONSHIP_COLLECTION="npc_relationships"
MEM0_EMBEDDING_DIMS="1536"
MEM0_HISTORY_DB_PATH="./memory_service/data/mem0-history.db"

# Initial documented Mem0 extraction/embedder configuration.
# These may be abstracted behind additional providers later, but this first
# adapter intentionally follows the documented MongoDB + Mem0 integration.
OPENAI_API_KEY="replace-with-server-side-key"
MEM0_LLM_MODEL="gpt-4o-mini"
MEM0_EMBEDDING_MODEL="text-embedding-3-small"
