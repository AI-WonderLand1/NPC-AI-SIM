# NPC-AI-SIM server environment
# Keep all real credentials out of git. Production values should come from
# Infisical / your server environment, not from client-side Vite variables.

# Existing Gemini server integration. Legacy endpoints still use this today.
GEMINI_API_KEY="replace-with-server-side-key"

# Optional canonical public app URL.
APP_URL="https://npc.example.com"

# Private Mem0 + MongoDB memory sidecar connection.
# The browser must never receive the service token or MongoDB credentials.
MEM0_SERVICE_URL="http://127.0.0.1:8788"
MEM0_SERVICE_TOKEN="replace-with-the-same-private-token-used-by-memory-service"
MEM0_SERVICE_TIMEOUT_MS="5000"

# MongoDB/OpenAI credentials belong in memory_service/.env or its production
# secret environment. Do NOT put MONGODB_URI in browser-exposed variables.
